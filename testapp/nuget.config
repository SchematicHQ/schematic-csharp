<?xml version="1.0" encoding="utf-8"?>
<!--
  Adds the local feed that scripts/e2e-pack.sh writes, for the `pack` install
  mode of the SDK E2E harness. nuget.org stays registered so transitive
  dependencies (Wasmtime, OpenFeature, StackExchange.Redis, ...) still resolve;
  nothing is cleared, so a developer's own sources keep working too.
-->
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- Relative to this file; created by scripts/e2e-pack.sh. -->
    <add key="schematic-e2e-local" value="../artifacts/local-feed" />
  </packageSources>
</configuration>
